# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=etf_atlas
DB_PORT=9602

# Backend
BACKEND_PORT=9601
# 로그인 세션 쿠키에 Secure 플래그 — https로 서비스할 때만 true (http에서 켜면 로그인 불가)
COOKIE_SECURE=false
# 32-byte hex (AES-256-GCM). 한 번 정하면 바꾸지 말 것 — 기존 암호화 데이터 복호화 불가
ENCRYPTION_KEY=

# AI (LiteLLM 프록시, OpenAI 호환 API) — 채팅 모델과 임베딩은 키가 다르다
# 채팅 모델: 챗봇, 질문 일반화, ETF 태깅
LLM_API_BASE=http://localhost:4000
LLM_API_KEY=
LLM_MODEL=qwen38-27b
# 임베딩: 챗봇 few-shot 예시 검색/적재 (768차원)
EMBEDDING_API_BASE=http://localhost:4000
EMBEDDING_API_KEY=
EMBEDDING_MODEL=embedding-gemma-300m

# Frontend
FRONTEND_PORT=9600
FRONTEND_URL=http://localhost:9600

# Airflow (UI: http://localhost:9603)
AIRFLOW_PORT=9603
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=admin
AIRFLOW_FERNET_KEY=
AIRFLOW_SECRET_KEY=
AIRFLOW_JWT_SECRET=


# 한국투자증권 KIS Open API — ETF 목록/시세/구성종목, 주식 일봉, 영업일/휴장일 (https://apiportal.koreainvestment.com, 실전투자 앱키)
KIS_APP_KEY=
KIS_APP_SECRET=
# 기본값: https://openapi.koreainvestment.com:9443
KIS_BASE_URL=

# (선택) 수집 완료 디스코드 알림
DISCORD_WEBHOOK_URL=
